# The settings production sets. There are no switches or local fallbacks: a missing setting
# fails loudly where it is used. The API, the Functions app and the email worker each set the
# subset they need.

JWT_SECRET=
# Frontend origin(s) allowed for CORS (comma-separated)
CORS_ORIGINS=https://ileracare.app

# Postgres with the pgvector extension: every record the app keeps (tables created on first
# use) and the RAG store. Populate the RAG index with:
#   DATABASE_URL=... python -m app.rag.ingest
DATABASE_URL=

# Intake happens before signup, so a case starts unowned and is claimed when its creator makes
# an account. Cases nobody claims within this many days are deleted.
UNCLAIMED_CASE_TTL_DAYS=5

# Eligibility research LLM and embeddings: the Azure OpenAI v1 endpoint, e.g.
# https://<resource>.openai.azure.com/openai/v1, and deployment names on it.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# Compact validated outputs; these token budgets also cover hidden reasoning.
ELIGIBILITY_MAX_OUTPUT_TOKENS=4096
RESEARCH_MAX_OUTPUT_TOKENS=3072
AGENT_REASONING_EFFORT=low

# Durable Functions eligibility pipeline
AZURE_FUNCTIONS_URL=
AZURE_FUNCTIONS_KEY=

# Email verification and login codes (Azure Communication Services — covered under Azure BAA)
ACS_EMAIL_CONNECTION_STRING=
# Public URL of the frontend — used to build the verification link sent in emails.
APP_URL=https://ileracare.app
# "From" address — must match a domain verified in your ACS Email resource (ileracare.app).
FROM_EMAIL=noreply@ileracare.app

# Microsoft 365 mailbox connections and scanning
EMAIL_MICROSOFT_TENANT_ID=
EMAIL_MICROSOFT_CLIENT_ID=
# Register a Web callback on the FRONTEND origin, not the backend host.
EMAIL_MICROSOFT_REDIRECT_URI=https://ileracare.app/api/email/microsoft/callback
EMAIL_KEY_VAULT_URL=
EMAIL_MICROSOFT_CLIENT_SECRET_NAME=ilera-microsoft-client-secret
EMAIL_TOKEN_ENCRYPTION_KEY_NAME=ilera-email-token-key
# Direct public API URL (the frontend API proxy requires a user session).
EMAIL_MICROSOFT_NOTIFICATION_URL=
# Namespace hostname only, e.g. ilera-email.servicebus.windows.net; no connection string.
EMAIL_SERVICE_BUS_NAMESPACE=
EMAIL_SERVICE_BUS_QUEUE=email.scan
# User-assigned identity client id (worker); empty uses the system-assigned identity.
EMAIL_MANAGED_IDENTITY_CLIENT_ID=
# Dedicated email extraction. Azure resource origin only, no /openai/v1 suffix.
EMAIL_OPENAI_ENDPOINT=
EMAIL_OPENAI_DEPLOYMENT=
EMAIL_SCAN_MAX_DELIVERIES=5

# Intake document reading: dedicated Azure OpenAI resource origin, no /openai/v1 suffix.
DOCUMENT_OPENAI_ENDPOINT=
DOCUMENT_OPENAI_DEPLOYMENT=

# Public reference guides (Azure Blob Storage, managed identity). Form PDFs ship in the image.
REFERENCE_GUIDES_BLOB_ACCOUNT_URL=
REFERENCE_GUIDES_BLOB_CONTAINER=reference-guides
