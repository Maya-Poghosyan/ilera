# Copy to .env and fill in. Everything is optional — the app boots without keys
# (RAG falls back to a local embedding, persistence falls back to in-memory).

# Frontend origin(s) allowed for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Postgres with the pgvector extension. When set it holds every record the app keeps —
# accounts, cases, reminders, timekeeping, journal, renewals, applications, preferences,
# suggested events (tables created on first use) — and is the RAG store: chunk text lives in
# a column and the KNN runs in the database, so this process holds neither.
# Nothing builds the RAG index for you — populate it once with:
#   DATABASE_URL=... python -m app.rag.ingest
DATABASE_URL=

# Intake happens before signup, so a case starts unowned and is claimed when its creator makes
# an account. Cases nobody claims within this many days are deleted; 0 keeps them forever.
UNCLAIMED_CASE_TTL_DAYS=30

# LLM. Specialists + Band agents use grounded reasoning when a key is present.
# OpenAI or an OpenAI-compatible endpoint (e.g. Azure OpenAI). For Azure, set
# OPENAI_MODEL=<deployment name> and OPENAI_BASE_URL to the resource v1 endpoint,
# e.g. https://<resource>.openai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Embeddings backend: "auto" (OpenAI if a key is set, else fastembed), "openai", or
# "fastembed". Use "fastembed" when your OpenAI/Azure endpoint has no embedding
# deployment (keeps RAG working locally with no embedding API).
EMBEDDING_PROVIDER=auto
# Embeddings: OpenAI/Azure if selected above, else local fastembed (no key needed).
EMBEDDING_MODEL=text-embedding-3-small
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Multi-agent coordination (Band) — docs.band.ai
# Agent credentials live in backend/band_agents.json (see band_agents.example.json):
# one {agent_id, api_key} per program group. These only override the connection URLs.
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Integrations
# Poke — agentic messaging (iMessage/WhatsApp/Telegram/RCS). Get a key at https://poke.com
# Used for caregiver reminders and daily care-log check-ins.
# The app boots without it — reminders are stored but not delivered.
POKE_API_KEY=
