# Copy to .env and fill in. Everything is optional — the app boots without keys
# (RAG falls back to a local embedding, persistence falls back to in-memory).

# Frontend origin(s) allowed for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Redis Cloud (RAG + agent memory + document store)
# redis.io/login -> +Database -> Essentials -> HA off -> promo CALHACKER2026
REDIS_URL=

# LLM (set one). Specialists use grounded reasoning when a key is present.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embeddings: OpenAI if OPENAI_API_KEY set, else local fastembed (no key needed).
EMBEDDING_MODEL=text-embedding-3-small
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Multi-agent coordination (Band) — docs.band.ai
BAND_API_KEY=

# Integrations
POKE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
