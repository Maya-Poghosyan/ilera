# Every environment variable on the API Container App. deploy.yml applies this file on each API
# deploy with --replace-env-vars, so a variable missing here is removed from the app.
# - Plain values: non-secret settings (this repo is public)
# - secretref:<name>: a Container App secret, set once with `az containerapp secret set`
DATABASE_URL=secretref:database-url
OPENAI_API_KEY=secretref:openai-api-key
JWT_SECRET=secretref:jwt-secret
OPENAI_BASE_URL=https://ilera-resource.openai.azure.com/openai/v1
CORS_ORIGINS=https://ileracare.app
AZURE_FUNCTIONS_URL=https://ilera-agent-orchestration.azurewebsites.net
ACS_EMAIL_CONNECTION_STRING=secretref:acs-email-connection-string
AZURE_FUNCTIONS_KEY=secretref:azure-functions-key
EMAIL_MICROSOFT_TENANT_ID=5c8a1e25-bdc4-4ced-b8c2-3cda51c721d9
EMAIL_MICROSOFT_CLIENT_ID=c3b57022-1fcd-4434-a04a-b9ce41e54987
EMAIL_MICROSOFT_REDIRECT_URI=https://ileracare.app/api/email/microsoft/callback
EMAIL_KEY_VAULT_URL=https://ilera-email-01a341d5.vault.azure.net
EMAIL_MICROSOFT_CLIENT_SECRET_NAME=ilera-microsoft-client-secret
EMAIL_TOKEN_ENCRYPTION_KEY_NAME=ilera-email-token-key
EMAIL_SERVICE_BUS_NAMESPACE=ilera-email-bus.servicebus.windows.net
EMAIL_SERVICE_BUS_QUEUE=email.scan
EMAIL_MICROSOFT_NOTIFICATION_URL=https://api.ileracare.app/api/email/microsoft/notifications
DOCUMENT_OPENAI_ENDPOINT=https://ilera-documents-01a341d5.openai.azure.com
DOCUMENT_OPENAI_DEPLOYMENT=gpt-5-mini
REFERENCE_GUIDES_BLOB_ACCOUNT_URL=https://ilerastorage.blob.core.windows.net
