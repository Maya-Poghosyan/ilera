# Copy to terraform.tfvars in this directory. Apply this module only when the scan worker
# image exists and the OAuth module has already been applied (this reads its state).
# Required values have no default — apply fails if they're missing.

subscription_id = "01a341d5-5453-4e83-92ee-4f0cc2e3d47d"
tenant_id       = "5c8a1e25-bdc4-4ced-b8c2-3cda51c721d9"
resource_group  = "Ilera"
location        = "eastus2"

container_apps_environment_name = "ilera-env"

# Existing Azure Container Registry holding the images (no .azurecr.io suffix).
container_registry_name = "caff3fa0d6e7acr"

# Worker image, built & pushed to the registry above.
scan_worker_image = "caff3fa0d6e7acr.azurecr.io/ilera-email-worker:<sha>"

# Full API image (has the whole app) used by the hourly maintenance job.
api_image = "caff3fa0d6e7acr.azurecr.io/ilera-api:<sha>"

# The single existing AIServices/OpenAI account and the deployment used for extraction.
# The worker calls it under https://<custom-subdomain>.openai.azure.com/ (derived in main.tf).
existing_openai_account_name = "ilera-resource"
email_openai_deployment_name = "gpt-5-mini"

# database_url is SENSITIVE — do NOT put it here. Provide it out of band, e.g.:
#   export TF_VAR_database_url="$(az containerapp secret show -g Ilera -n ilera-api \
#       --secret-name database-url --query value -o tsv)"
