# Copy to terraform.tfvars and adjust. NON-SECRET values only. The Fernet key is
# generated and stored in Key Vault by Terraform. The Entra app and its client secret are
# managed OUTSIDE Terraform (see entra.tf); write the secret into the vault out-of-band.
#
# This is the OAuth-slice module. The scanning pipeline is a separate module in scanning/.

subscription_id = "01a341d5-5453-4e83-92ee-4f0cc2e3d47d"
tenant_id       = "5c8a1e25-bdc4-4ced-b8c2-3cda51c721d9"
resource_group  = "Ilera"
location        = "eastus2"

api_app_name = "ilera-api"

mailbox_client_id = "c3b57022-1fcd-4434-a04a-b9ce41e54987" # existing Entra app, managed out of band
redirect_uri      = "https://ileracare.app/api/email/microsoft/callback"
vault_name        = "ilera-email-01a341d5"

# HIPAA: reuse an existing Log Analytics workspace if you have one; otherwise leave empty
# to create a dedicated one for email audit logs.
# log_analytics_workspace_id = "/subscriptions/.../workspaces/ilera-logs"

# EMAIL_CONNECTIONS_ENABLED / EMAIL_SCANNING_ENABLED are set directly in data.tf (both
# "false"). Change them there when you're ready; the plan diff will show the change.
