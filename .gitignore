# Python
backend/.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
!*.env.example

# Band per-agent credentials (use band_agents.example.json as a template)
backend/band_agents.json

# Node / Next
node_modules/
.next/
out/
.DS_Store

# Local data artifacts
backend/data/program_docs/*.pdf
backend/data/generated/

# Terraform (infra/azure). State can contain secret values — never commit it.
# The provider lock file (.terraform.lock.hcl) SHOULD be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
