{
  "$defs": {
    "GuidanceResource": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portal",
            "form",
            "document",
            "contact",
            "instructions"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "checked_on": {
          "format": "date",
          "title": "Checked On",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "kind",
        "title",
        "source_url",
        "checked_on"
      ],
      "title": "GuidanceResource",
      "type": "object"
    },
    "ResolutionMethod": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "manual_entry",
            "targeted_question",
            "document_upload"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "ResolutionMethod",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "minLength": 1,
      "title": "Template Id",
      "type": "string"
    },
    "category": {
      "default": "general",
      "enum": [
        "financial",
        "coverage",
        "medical",
        "household",
        "employment",
        "general"
      ],
      "title": "Category",
      "type": "string"
    },
    "profile_path": {
      "title": "Profile Path",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "guided_steps": {
      "items": {
        "type": "string"
      },
      "title": "Guided Steps",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/GuidanceResource"
      },
      "title": "Resources",
      "type": "array"
    },
    "acceptable_evidence_types": {
      "items": {
        "type": "string"
      },
      "title": "Acceptable Evidence Types",
      "type": "array"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/ResolutionMethod"
      },
      "title": "Methods",
      "type": "array"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "template_id",
    "profile_path",
    "title"
  ],
  "title": "ResolutionTemplate",
  "type": "object"
}
